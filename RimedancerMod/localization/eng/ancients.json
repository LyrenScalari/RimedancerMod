{
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.0-0.char": "Defenseless and alone, an easy mark...",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.0-0.next": "Continue",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.0-1.ancient": "What a worthless urchin, BEGONE.",
  
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.1-0.ancient": "You return? What is it you seek?",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.1-0.next": "Answer",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.1-1.char": "The Unseen Atlas... A Stolen Relic of my-",
