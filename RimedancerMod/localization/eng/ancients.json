  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.1-2.ancient": "Never. None shall bear the Atlas again.",

  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.2-0r.ancient": "Don't think you can avoid my gaze wretch!",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.2-0r.next": "Appear",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.2-1r.char": "[i][font_size=22]The Rimedancer steps out of the shadows...[/font_size][/i]",
