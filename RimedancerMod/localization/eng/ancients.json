  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.2-2r.ancient": "Lone Phantom, forget the Atlas, pester me no more!",
  
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.3-0r.ancient": "Your persistence defies logic.",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.3-0r.next": "Continue",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.3-1r.char": "Until the Atlas is in my claws, I must persist.",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.3-1r.next": "Continue",
  "THE_ARCHITECT.talk.RIMEDANCERMOD-RIMEDANCER_MOD.3-2r.ancient": "A pity, your search will never end then.",
  
  "NEOW.talk.RIMEDANCERMOD-RIMEDANCER_MOD.0-0.ancient": "[sine]...Knave.. arise...\n....Seek The Atlas...[/sine]",
  "NEOW.talk.RIMEDANCERMOD-RIMEDANCER_MOD.0-0.next": "Talk",
